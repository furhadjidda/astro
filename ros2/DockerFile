# syntax=docker/dockerfile:1.7
ARG ROS_BASE=ros:humble-ros-base-jammy@sha256:a18afd4a42ad603579d03b9012385dfeaf2e848423f0a6c41699766e7849c86c
ARG ROS_CORE=ros:humble-ros-core-jammy@sha256:1f9ff77348bbd0a2c06c1ee222b71e2e6dbf54b73cff63387a7bd4467a23a354
ARG LIBREALSENSE_VERSION=v2.56.4
ARG BUILD_JOBS=2
ARG PARALLEL_WORKERS=2

FROM ${ROS_BASE} AS librealsense
ARG LIBREALSENSE_VERSION
ARG BUILD_JOBS
RUN apt-get update && apt-get install -y --no-install-recommends \
      git cmake build-essential pkg-config \
      libusb-1.0-0-dev libssl-dev libudev-dev \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch "${LIBREALSENSE_VERSION}" \
      https://github.com/IntelRealSense/librealsense.git /tmp/librealsense \
    && cmake -S /tmp/librealsense -B /tmp/rs-build \
      -DCMAKE_BUILD_TYPE=Release \
      -DFORCE_RSUSB_BACKEND=ON \
      -DBUILD_EXAMPLES=OFF \
      -DBUILD_GRAPHICAL_EXAMPLES=OFF \
      -DBUILD_GLSL_EXTENSIONS=OFF \
      -DBUILD_TOOLS=ON \
      -DBUILD_WITH_CUDA=OFF \
      -DIMPORT_DEPTH_CAM_FW=OFF \
      -DCMAKE_INSTALL_PREFIX=/usr/local \
    && cmake --build /tmp/rs-build --parallel "${BUILD_JOBS}" \
    && cmake --install /tmp/rs-build \
    && mkdir -p /opt/rs-runtime/lib /opt/rs-runtime/bin \
    && cp -a /usr/local/lib/librealsense2.so* /opt/rs-runtime/lib/ \
    && cp /usr/local/bin/rs-enumerate-devices /opt/rs-runtime/bin/

FROM ${ROS_BASE} AS fetch
RUN apt-get update && apt-get install -y --no-install-recommends \
      git python3-vcstool && rm -rf /var/lib/apt/lists/*
WORKDIR /ws
COPY astro.repos /ws/astro.repos
RUN mkdir -p src && vcs import < astro.repos

FROM ${ROS_BASE} AS builder
ARG BUILD_JOBS
ARG PARALLEL_WORKERS
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive \
    CCACHE_DIR=/root/.ccache \
    CMAKE_C_COMPILER_LAUNCHER=ccache \
    CMAKE_CXX_COMPILER_LAUNCHER=ccache
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake git ccache python3-colcon-common-extensions \
      python3-rosdep libusb-1.0-0-dev libudev-dev \
      ros-humble-depthai-ros-v3 \
    && rm -rf /var/lib/apt/lists/*
RUN apt-get update && apt-get install -y --no-install-recommends libssl-dev \
    && rm -rf /var/lib/apt/lists/*
COPY --from=librealsense /usr/local/ /usr/local/
RUN ldconfig \
    && if [ ! -f /etc/ros/rosdep/sources.list.d/20-default.list ]; then rosdep init; fi \
    && rosdep update --rosdistro humble
WORKDIR /ws

# Cache the external dependencies and their build before copying local packages.
COPY --from=fetch /ws/src/external/ src/external/
RUN --mount=type=cache,target=/root/.ccache \
    apt-get update \
    && rosdep install --from-paths src --ignore-src -y \
      --skip-keys "librealsense2" \
    && source /opt/ros/humble/setup.bash \
    && MAKEFLAGS="-j${BUILD_JOBS}" colcon build --merge-install \
      --packages-select micro_ros_agent --parallel-workers "${PARALLEL_WORKERS}" \
      --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
      "-DOPENSSL_CRYPTO_LIBRARY=/usr/lib/$(g++ -print-multiarch)/libcrypto.so" \
      "-DOPENSSL_SSL_LIBRARY=/usr/lib/$(g++ -print-multiarch)/libssl.so" \
    && MAKEFLAGS="-j${BUILD_JOBS}" colcon build --merge-install \
      --parallel-workers "${PARALLEL_WORKERS}" --packages-skip-build-finished \
      --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
    && rm -rf /var/lib/apt/lists/*

COPY src/ src/
RUN --mount=type=cache,target=/root/.ccache \
    apt-get update \
    && rosdep install --from-paths src --ignore-src -y \
      --skip-keys "librealsense2" \
    && source /opt/ros/humble/setup.bash \
    && MAKEFLAGS="-j${BUILD_JOBS}" colcon build --merge-install \
      --parallel-workers "${PARALLEL_WORKERS}" --packages-skip-build-finished \
      --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
    && rm -rf /var/lib/apt/lists/*

FROM ${ROS_CORE} AS runtime
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive \
    RMW_IMPLEMENTATION=rmw_fastrtps_cpp
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3-rosdep libusb-1.0-0 libudev1 \
      ros-humble-depthai-ros-v3 \
      ros-humble-robot-state-publisher ros-humble-joint-state-publisher \
    && rm -rf /var/lib/apt/lists/*
COPY --from=librealsense /opt/rs-runtime/ /usr/local/
RUN ldconfig
COPY --from=builder /ws/install/ /ws/install/
RUN if [ ! -f /etc/ros/rosdep/sources.list.d/20-default.list ]; then rosdep init; fi \
    && apt-get update \
    && rosdep update --rosdistro humble \
    && rosdep install --from-paths /ws/install/share --ignore-src -y \
      --dependency-types exec --skip-keys "librealsense2" \
    && apt-get purge -y python3-rosdep \
    && rm -rf /var/lib/apt/lists/* /root/.ros/rosdep
COPY --chmod=755 docker-entrypoint.sh /docker-entrypoint.sh
ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["bash"]

repositories:
  src/external/DynamixelSDK:
    type: git
    url: https://github.com/ROBOTIS-GIT/DynamixelSDK.git
    version: humble
  src/external/realsense_ros:
    type: git
    url: https://github.com/IntelRealSense/realsense-ros.git
    version: r/4.56.4
  src/external/sllidar_ros2:
    type: git
    url: https://github.com/Slamtec/sllidar_ros2.git
    version: main
  # depthai-core and depthai-ros are installed from apt (ros-humble-depthai-ros-v3).
  # vision_msgs is also pulled in as a transitive apt dependency.
  # No source clones needed.
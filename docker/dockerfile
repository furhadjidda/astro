FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# -----------------------------------------------------------------------------
# System dependencies required by Zephyr + SDK
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    file \
    git \
    locales \
    python3 \
    python3-pip \
    python3-venv \
    cmake \
    ninja-build \
    build-essential \
    device-tree-compiler \
    xz-utils \
    unzip \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Locale (some Zephyr tools expect UTF-8)
RUN locale-gen en_US.UTF-8
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

# -----------------------------------------------------------------------------
# Install Zephyr SDK (fixed version, non-interactive)
# -----------------------------------------------------------------------------
ENV ZEPHYR_SDK_VERSION=1.0.1
ENV ZEPHYR_SDK_INSTALL_DIR=/opt/zephyr-sdk-${ZEPHYR_SDK_VERSION}
ENV ZEPHYR_SDK_TOOLCHAIN=xtensa-espressif_esp32s3_zephyr-elf

RUN curl -fL \
    https://github.com/zephyrproject-rtos/sdk-ng/releases/download/v${ZEPHYR_SDK_VERSION}/zephyr-sdk-${ZEPHYR_SDK_VERSION}_linux-x86_64_minimal.tar.xz \
    -o /tmp/zephyr-sdk.tar.xz && \
    echo "ca9bc0ff66fafca1dac9d592a36d953cf16d096a9d09b1c0357f021cf9f6a7eb  /tmp/zephyr-sdk.tar.xz" | sha256sum --check - && \
    tar -xJf /tmp/zephyr-sdk.tar.xz -C /opt && \
    rm /tmp/zephyr-sdk.tar.xz

RUN /bin/bash ${ZEPHYR_SDK_INSTALL_DIR}/setup.sh \
    -t ${ZEPHYR_SDK_TOOLCHAIN} \
    -h \
    -c

# Make SDK discoverable by Zephyr
ENV PATH="${ZEPHYR_SDK_INSTALL_DIR}/gnu/${ZEPHYR_SDK_TOOLCHAIN}/bin:${ZEPHYR_SDK_INSTALL_DIR}/hosttools/sysroots/x86_64-pokysdk-linux/usr/bin:${PATH}"

# -----------------------------------------------------------------------------
# Python virtual environment (image-owned)
# -----------------------------------------------------------------------------
ENV UV_PYTHON_INSTALL_DIR=/opt/uv-python

RUN python3 -m venv /opt/uv && \
    /opt/uv/bin/pip install --no-cache-dir --upgrade pip uv && \
    /opt/uv/bin/uv python install 3.12 && \
    /opt/uv/bin/uv venv --python 3.12 --seed /opt/zephyr-venv && \
    /opt/uv/bin/uv pip install --python /opt/zephyr-venv/bin/python \
        west \
        patool \
        pykwalify \
        catkin_pkg \
        lark-parser \
        'empy==3.3.4' \
        colcon-common-extensions
RUN chmod -R a+rX /opt/uv-python && \
    chmod -R a+rwX /opt/zephyr-venv


# -----------------------------------------------------------------------------
# Sanity checks (fail fast if something is wrong)
# -----------------------------------------------------------------------------
RUN test -x ${ZEPHYR_SDK_INSTALL_DIR}/gnu/${ZEPHYR_SDK_TOOLCHAIN}/bin/xtensa-espressif_esp32s3_zephyr-elf-gcc
RUN test -x ${ZEPHYR_SDK_INSTALL_DIR}/hosttools/sysroots/x86_64-pokysdk-linux/usr/bin/dtc
RUN /opt/zephyr-venv/bin/python --version
RUN /opt/zephyr-venv/bin/west --version

# -----------------------------------------------------------------------------
# Runtime configuration
# -----------------------------------------------------------------------------
SHELL ["/bin/bash", "-c"]
ENTRYPOINT ["bash", "-c", "source /opt/zephyr-venv/bin/activate && exec bash"]
